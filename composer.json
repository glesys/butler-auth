{
    "name": "glesys/butler-auth",
    "description": "",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Butler\\Auth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Butler\\Auth\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.3",
        "illuminate/bus": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/support": "^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "mockery/mockery": "^1.6.9",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^11.5.50"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Butler\\Auth\\ServiceProvider"
            ]
        }
    }
}
