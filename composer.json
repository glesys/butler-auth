{
    "name": "glesys/butler-auth",
    "description": "",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Butler\\Auth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Butler\\Auth\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.3",
        "illuminate/bus": "^12.0 | ^13.0",
        "illuminate/contracts": "^12.0 | ^13.0",
        "illuminate/database": "^12.0 | ^13.0",
        "illuminate/queue": "^12.0 | ^13.0",
        "illuminate/support": "^12.0 | ^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "mockery/mockery": "^1.6.9",
        "orchestra/testbench": "^10.0 | ^11.0",
        "phpunit/phpunit": "^10.5.13 | ^11.0"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Butler\\Auth\\ServiceProvider"
            ]
        }
    }
}
